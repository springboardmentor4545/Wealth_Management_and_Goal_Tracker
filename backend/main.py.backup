from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

# Import the API router
try:
    from app.api.v1.auth.auth_simple import router as auth_router
    print("? Successfully imported api_router from app.api.v1.api")
except ImportError as e:
    print(f"? Failed to import api_router: {e}")
    # Create a fallback router
    from fastapi import APIRouter
    api_router = APIRouter()
    
    @api_router.get("/test")
    async def test_endpoint():
        return {"message": "API v1 is working (fallback)"}
    
    @api_router.get("/health")
    async def health_check():
        return {"status": "healthy (fallback)"}

app = FastAPI(title="Wealth Tracker API")

# CORS middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "http://localhost:5173",
        "http://localhost:3000",
        "http://localhost:8000"
    ],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# IMPORTANT: Include the router with prefix
app.include_router(auth_router, prefix="/api/v1/auth")

@app.get("/")
def read_root():
    return {"message": "Wealth Tracker API"}

